{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/sector-deep-dive/", "destination": "/sector-deep-dive", "permanent": true },
    { "source": "/budget-realities/", "destination": "/budget-realities", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/budget-at-a-glance", "destination": "/", "permanent": true },
    { "source": "/Budget%20at%20a%20Glance.html", "destination": "/", "permanent": true },
    { "source": "/sector-deep-dive.html", "destination": "/sector-deep-dive", "permanent": true },
    { "source": "/Sector%20Deep%20Dive.html", "destination": "/sector-deep-dive", "permanent": true },
    { "source": "/budget-realities.html", "destination": "/budget-realities", "permanent": true },
    { "source": "/Budget%20Realities.html", "destination": "/budget-realities", "permanent": true }
  ],
  "functions": {
    "api/news.js": { "runtime": "nodejs20.x" }
  },
  "headers": [
    {
      "source": "/_assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/news-images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
